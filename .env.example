# Copy this file to .env and fill in values as needed for local development.
# In production (Render), set these as environment variables in the
# service's dashboard instead of committing a .env file.

# Port the Express server listens on. Render sets this automatically in
# production — only needed for local dev, and only if you want something
# other than the default.
PORT=3001

# Optional. Discord webhook URL used to post an alert when a test result is
# marked "failed". If unset, failure alerts are silently skipped (see
# server/test-runs.js) — the app works fine without this.
DISCORD_WEBHOOK_URL=

# Optional. Base URL used to build the link back to a test run inside a
# Discord failure alert. Defaults to http://localhost:5173 if unset.
APP_BASE_URL=
